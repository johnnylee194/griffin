# Griffin Backend Environment Variables

# ==================== 数据库配置 ====================
DATABASE_URL="file:./data/griffin.db"

# ==================== JWT 配置 ====================
# JWT 密钥（用于生成和验证 token）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# ==================== 服务器配置 ====================
# 后端监听端口
PORT=3000

# Node 环境
NODE_ENV=production

# ==================== CORS 配置 ====================
# 前端地址（用于 CORS，多个地址用逗号分隔）
FRONTEND_URL=http://localhost:5173

# ==================== 数据库备份配置（仅生产环境宿主机使用） ====================
# 独立私有 GitHub 备份仓库在宿主机上的本地 clone 路径
# 测试环境请留空或注释掉，避免覆盖生产备份
# BACKUP_REPO_PATH=/path/to/your-private-backup-repo
