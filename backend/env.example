# Griffin Backend Environment Variables

# ==================== 数据库配置 ====================
DATABASE_URL="file:./data/griffin.db"

# ==================== JWT 配置 ====================
# JWT 密钥（用于生成和验证 token）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ==================== Iris API 配置 ====================
# Iris Gateway URL
IRIS_URL=http://us-proxy.januslab.cn:8080

# Griffin 在 Iris 中的客户端凭证
# 从 Iris 管理员处获取
IRIS_CLIENT_ID=griffin-app
IRIS_CLIENT_SECRET=your-client-secret-here

# ==================== 服务器配置 ====================
# 后端监听端口
PORT=3001

# Node 环境
NODE_ENV=production

# ==================== CORS 配置 ====================
# 前端地址（用于 CORS）
FRONTEND_URL=http://localhost:5173
