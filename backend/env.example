# Griffin Backend Environment Variables

# ==================== 数据库配置 ====================
DATABASE_URL="file:./data/griffin.db"

# ==================== JWT 配置 ====================
# JWT 密钥（用于生成和验证 token）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ==================== 服务器配置 ====================
# 后端监听端口
PORT=3001

# Node 环境
NODE_ENV=production

# ==================== CORS 配置 ====================
# 前端地址（用于 CORS）
FRONTEND_URL=http://localhost:5173

# ==================== 地图 API 配置 ====================
# 高德地图 API Key (用于地理编码获取经纬度)

# ==================== LLM Provider 配置 ====================
# 选择使用的 LLM 提供商 (minimax 或 deepseek)

# MiniMax 配置

# DeepSeek 配置
